<div id="<%= dom_id resource %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Title:</strong>
    <%= resource.title %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Url:</strong>
    <%= resource.url %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Synopsis:</strong>
    <%= resource.synopsis %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Body:</strong>
    <%= resource.body %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Chapters:</strong>
    <%= resource.chapters %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Notes:</strong>
    <%= resource.notes %>
  </p>

</div>
